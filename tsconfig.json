{
	"compileOnSave": true,
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"sourceMap": true,
		"declaration": true,
		"watch": false,
		"rootDir": "src",
		"outDir": "dist",
		"noEmitOnError": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"types": [
			"node",
			"jest",
			"jest-expect-message"
		],
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"target": "ES2020",
		"lib": [
			"ES2020"
		]
	},
	"include": [
		"src"
	],
	"exclude": [
		"dist"
	]
}
