{
  "testEnvironment": "node",
  "testTimeout": 100000,
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "useESM": true, "tsconfig": { "module": "ES2020", "esModuleInterop": true } }]
  },
  "extensionsToTreatAsEsm": [".ts"],
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "moduleFileExtensions": [
    "ts",
    "js",
    "json",
    "node"
  ],
  "forceExit": true,
  "detectOpenHandles": true,
  "setupFilesAfterEnv": [
    "@alex_neo/jest-expect-message"
  ],
  "testRegex": "(/__tests__/.*|(\\.|/)(test|spec))\\.(ts)$",
  "coverageDirectory": "coverage",
  "collectCoverageFrom": [
    "src/**/*.{ts,js}"
  ]
}
