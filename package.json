{
  "name": "nanium-queue-mongodb",
  "version": "2.0.0",
  "description": "request queue for the nanium framework using a mongodb collection to hold the request entries",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "clean": "rm -rf dist",
    "cleanbuild": "npm run clean && npm run build",
    "test": "npm run build && node --experimental-vm-modules ./node_modules/jest/bin/jest.js",
    "bundle": "npm run test && npm publish"
  },
  "keywords": [
    "nanium",
    "queue",
    "mongodb"
  ],
  "files": [
    "/dist/index.js",
    "/dist/index.d.ts"
  ],
  "author": "Tobias Wenzel",
  "license": "MIT",
  "devDependencies": {
    "@alex_neo/jest-expect-message": "^1.0.5",
    "@types/jest": "^29.5.0",
    "@types/jest-expect-message": "^1.0.3",
    "jest": "^29.7.0",
    "mongodb": "<7.0.0",
    "mongodb-memory-server": "^9.5.0",
    "ts-jest": "^29.2.0",
    "tslint": "^6.1.3",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "mongodb": "<7.0.0",
    "nanium": ">=2.0.0 <3.0.0"
  }
}
